# ── Sito ────────────────────────────────────────────────────────────────
# Con `make` l'URL è calcolato da HTTPS_PORT (vedi Makefile): imposta questa
# variabile solo per un dominio diverso (es. tunnel).
# NEXT_PUBLIC_SITE_URL=https://cosenzaattrattiva.test

# ── Database (hostname "db" = servizio compose) ─────────────────────────
POSTGRES_USER=cosenza
POSTGRES_PASSWORD=cosenza
POSTGRES_DB=cosenza
DATABASE_URL=postgres://cosenza:cosenza@db:5432/cosenza
# Porta esposta solo su 127.0.0.1 per Drizzle Studio / psql dall'host
DB_HOST_PORT=5433

# ── Google Maps Platform (opzionale) ────────────────────────────────────
# Abilita: Maps JavaScript API, Map Tiles API. Restringi al referrer
# https://cosenzaattrattiva.test/*  — senza chiave l'app usa solo MapLibre.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Feature flag (fase 2) ───────────────────────────────────────────────
# (3D e Street View si attivano solo se è presente anche la chiave Google)
NEXT_PUBLIC_FEATURE_3D=true
# Motore del volo 3D: "maplibre" (rilievo ed edifici 3D da dati locali, nessuna chiave) oppure
# "google" (Photorealistic 3D Tiles: chiave + Map Tiles API + account non dello Spazio economico europeo)
NEXT_PUBLIC_FLY3D_PROVIDER=maplibre
NEXT_PUBLIC_FEATURE_STREETVIEW=true
NEXT_PUBLIC_FEATURE_AR=true
NEXT_PUBLIC_FEATURE_ASSISTANT=true

# ── Strumenti demo (simulatore di posizione) ────────────────────────────
NEXT_PUBLIC_DEMO_TOOLS=true

# Password del sito di riferimento vivi-cosenza.netlify.app (solo per make reference)
REF_PASSWORD=
# …oppure il cookie della sessione già aperta nel browser, formato nome=valore
REF_COOKIE=
