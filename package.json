{
  "name": "cosenza-attrattiva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:studio": "drizzle-kit studio --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "routes": "tsx scripts/build-routes.ts",
    "routes:links": "tsx scripts/build-links.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@serwist/turbopack": "9.5.15",
    "@turf/along": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/length": "7.4.0",
    "@turf/line-slice-along": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "drizzle-orm": "0.45.4",
    "maplibre-gl": "6.19.0",
    "marked": "18.2.1",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "pmtiles": "4.5.0",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "serwist": "9.5.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/google.maps": "^3.67.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core"
    ]
  }
}
